{
  "name": "meetentry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automatic Google Meet entrance music (Chrome MV3 extension)",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build:ui": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build": "npm run clean && npm run typecheck && npm run build:ui && npm run build:scripts",
    "watch:ui": "vite build --watch --mode development",
    "watch:scripts": "node scripts/build-scripts.mjs --watch",
    "test": "vitest run",
    "test:loopback": "node scripts/loopback-test.mjs",
    "test:e2e": "node scripts/e2e-mock-meet.mjs",
    "test:browser": "npm run test:loopback && npm run test:e2e",
    "screenshots": "node scripts/ui-screenshot.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run build && node scripts/package-zip.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.50.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
